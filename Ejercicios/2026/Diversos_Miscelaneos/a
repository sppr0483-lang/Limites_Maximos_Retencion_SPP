  formula = NumClaims ~ FACT1 + FACT2,
  family = "poisson",
  data = data1,
  offset = log(Duration)
)

summary(mymodel)

mat1 <- model.matrix(mymodel, data = data1)
betas1 <- coef(mymodel)

############################Validacion
